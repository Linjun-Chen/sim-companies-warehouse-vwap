{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "__MSG_extensionName__",
  "version": "1.2.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.simcompanies.com/*"],
  "background": {
    "service_worker": "src/worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.simcompanies.com/*"],
      "css": ["src/warehouse.css"],
      "js": ["src/preferences.js", "src/dates.js", "src/i18n.js", "src/warehouse.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.simcompanies.com/*"],
      "js": ["src/native-chart.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
